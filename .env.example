# Environment variables for local reproduction.
# Copy this file to .env and fill in the values. The real .env is gitignored —
# never commit filled-in secrets, and never paste real keys into any tracked file.

# Repository root. Leave as "." when running scripts from the repository root,
# or set an absolute path to run from elsewhere.
ACCESS_DECLINE_ROOT=.

# Geocoding API keys. Only needed to re-run the private bank-branch preprocessing
# under data/bank/ (2-geocode_api.ipynb, 99-geocode_additional.R). The public
# synthetic tutorial does NOT require these.
# Rotate each key in its provider console before use.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_API_KEY=
GOOGLE_API_KEY=
